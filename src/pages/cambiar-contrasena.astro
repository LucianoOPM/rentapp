---
import { actions, isInputError } from 'astro:actions';
import { authService } from '@lib/container';
import Field from '@components/Field.astro';
import LogoutForm from '@components/LogoutForm.astro';
import Layout from '@layouts/Layout.astro';

// Va antes de consultar la sesión: tras el cambio, la cookie que llegó con esta petición ya no vale.
const result = Astro.getActionResult(actions.changePassword);
if (result && !result.error) return Astro.redirect('/');

const logout = Astro.getActionResult(actions.logout);
if (logout && !logout.error) return Astro.redirect('/login');

// shortcut: aquí no se renueva la cookie de sesión; lo hará el middleware (Fase 0, punto 4).
const session = await authService.getSession(Astro.request.headers);
if (result?.error?.code === 'UNAUTHORIZED' || !session) return Astro.redirect('/login');

const fields = isInputError(result?.error) ? result.error.fields : undefined;
const message = logout?.error?.message ?? (result?.error && !fields ? result.error.message : undefined);
---

<Layout title="Cambiar contraseña">
	<h1 class="mb-2 text-2xl font-bold">Cambia tu contraseña</h1>
	<p class="mb-4">Elige una de al menos 8 caracteres, distinta de la actual.</p>
	{message && <p role="alert" class="mb-4 text-red-700">{message}</p>}
	<form method="POST" action={actions.changePassword} class="space-y-4">
		<Field name="currentPassword" label="Contraseña actual" type="password" autocomplete="current-password" errors={fields?.currentPassword} />
		<Field name="newPassword" label="Nueva contraseña" type="password" autocomplete="new-password" minlength="8" errors={fields?.newPassword} />
		<Field name="confirmPassword" label="Repite la nueva contraseña" type="password" autocomplete="new-password" minlength="8" errors={fields?.confirmPassword} />
		<button class="min-h-11 w-full rounded bg-blue-700 px-4 text-base font-medium text-white">Guardar contraseña</button>
	</form>
	<LogoutForm />
</Layout>
