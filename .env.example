# Desarrollo: conexión directa (host sin -pooler) de la rama dev de Neon.
# Netlify: conexión con pooler de la rama production. En ambas, usa sslmode=verify-full.
DATABASE_URL=
# Mínimo 32 caracteres. Genera uno distinto por entorno:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# En desarrollo: http://localhost:4321
BETTER_AUTH_URL=
# cloudinary://<api_key>:<api_secret>@<cloud_name>, como la entrega el panel de Cloudinary.
# En su cuenta, activa Settings > Security > "Allow delivery of PDF and ZIP files".
CLOUDINARY_URL=
# API key de Resend con permiso "Sending access".
RESEND_API_KEY=
# onboarding@resend.dev mientras no haya dominio propio.
MAIL_FROM=
# Recibe los avisos. Sin dominio propio, debe ser el correo de la cuenta de Resend.
ADMIN_EMAIL=
WIFI_ENC_KEY=
